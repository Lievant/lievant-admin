# ═══════════════════════════════════════════════════════
# LIEVANT ADMIN — Variables de entorno
# ═══════════════════════════════════════════════════════
# IMPORTANTE: Este archivo es una PLANTILLA.
# Crea un .env.local con los valores reales.
# NUNCA commitees .env con valores reales a GitHub.
# Todos los secretos reales viven en AWS Secrets Manager.
# ═══════════════════════════════════════════════════════

# ─── Ambiente ───────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev

# ─── URLs ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1

# ─── AWS Cognito (Auth / SSO) ────────────────────────────
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_DOMAIN=lievant-dev.auth.us-east-1.amazoncognito.com

# ─── AWS General ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=xxxxxxxxxxxx

# ─── Base de datos (NestJS API) ──────────────────────────
DATABASE_URL=postgresql://api_service:password@localhost:5432/lievant_dev
DATABASE_SCHEMA=auth

# ─── Redis (caché) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_IN_SECRETS_MANAGER
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AWS SES (emails) ────────────────────────────────────
SES_FROM_EMAIL=no-reply@lievant.com
SES_REGION=us-east-1

# ─── Feature flags ───────────────────────────────────────
ENABLE_DARK_MODE=false
ENABLE_DATA_LAKE=false
