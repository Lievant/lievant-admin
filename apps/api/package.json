{
  "name": "@lievant/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Administrativo de Lievant — API (NestJS 10)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:clean": "npx kill-port 3001 && npm run dev",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rimraf dist coverage",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "seed:super-admin": "ts-node -T src/database/seeds/super-admin.seed.ts",
    "seed:clients": "ts-node -T src/database/seeds/clients.seed.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/database/seeds/001-admin-user.ts",
    "seed:contpaqi-clients": "ts-node -T src/database/seeds/002-contpaqi-clients.seed.ts",
    "seed:employees": "ts-node -T src/database/seeds/003-employees-headcount.seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/client-ses": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "aws-jwt-verify": "^5.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "docx-templates": "^4.15.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "rimraf": "^5.0.7",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
