{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "baseUrl": "./",
    // Las pruebas importan componentes y utilidades del web (TSX con alias «@/»).
    "jsx": "react-jsx",
    "paths": { "@/*": ["../web/src/*"] },
    "incremental": true,
    "sourceMap": true
  }
}
